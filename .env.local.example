NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Postgres (Project Settings → Database → Connection string → URI).
# Dipakai script migrasi (npm run db:migrate). Ganti [YOUR-PASSWORD] dengan password DB.
DATABASE_URL=

# Bank Konten — baca live Google Sheet "CONTENT LIST" (read-only).
# ID sheet ada di URL: docs.google.com/spreadsheets/d/<INI>/edit
BANK_KONTEN_SHEET_ID=
# API key Google Cloud (aktifkan "Google Sheets API"). Sheet harus di-share
# "anyone with the link can view" agar cukup API key tanpa OAuth.
GOOGLE_SHEETS_API_KEY=
